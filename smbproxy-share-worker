#!/usr/bin/env bash
#===============================================================================
# smbproxy-share-worker — backend health and queued CNC-file delivery
#
# Runs from smbproxy-share-worker.timer. Direct shares are withdrawn from
# new Samba tree connects after bounded TCP/445 failures. Queued shares keep
# serving their local data-disk copy and deliver office-managed file changes
# to the backend whenever it is reachable.
#
# Queued delivery is deliberately one-way:
#   - a successful upload records the local checksum in a manifest;
#   - an unchanged local file is never re-applied, so a machine-side manual
#     edit survives until the office changes and redeploys that file;
#   - a local deletion removes only a path recorded in the manifest;
#   - machine-only files are never imported, overwritten, or deleted.
#===============================================================================
set -uo pipefail

STATE_DIR="${SMBPROXY_STATE_DIR:-/var/lib/smbproxy}"
SHARES_DIR="${SMBPROXY_SHARES_DIR:-${STATE_DIR}/shares}"
HEALTH_DIR="${SMBPROXY_HEALTH_DIR:-${STATE_DIR}/health}"
DATA_ROOT="${SMBPROXY_DATA_ROOT:-/srv/smbproxy-data}"
SESSION_ROOT="${SMBPROXY_SESSION_ROOT:-/run/smbproxy/sessions}"
SMB_CONF="${SMBPROXY_SMB_CONF:-/etc/samba/smb.conf}"
SMB_CONF_LOCK="${SMBPROXY_SMB_CONF_LOCK:-/run/lock/smbproxy-smb-conf.lock}"
LOCK_FILE="${SMBPROXY_WORKER_LOCK:-/run/lock/smbproxy-share-worker.lock}"
OFFLINE_PATH="${SMBPROXY_OFFLINE_PATH:-/run/smbproxy/offline}"
PROBE_HINT_DIR="${SMBPROXY_PROBE_HINT_DIR:-/run/smbproxy/probe-fail}"
FAIL_THRESHOLD="${SMBPROXY_FAIL_THRESHOLD:-2}"
PROBE_SECONDS="${SMBPROXY_PROBE_SECONDS:-1}"
MOUNT_SECONDS="${SMBPROXY_MOUNT_SECONDS:-8}"
SKIP_RELOAD="${SMBPROXY_SKIP_RELOAD:-0}"
KVSTATE="${SMBPROXY_APPCORE_KVSTATE:-/usr/local/lib/appliance-core/kvstate.sh}"
SHARE_STATE_KEYS=(SHARE_NAME PROFILE OFFLINE_MODE BACKEND_IP BACKEND_USER BACKEND_DOMAIN BACKEND_MOUNT BACKEND_VERS BACKEND_SEAL FRONT_GROUP FRONT_FORCE_USER LOCKING_OVERRIDE)
HEALTH_KEYS=(MODE BACKEND_REACHABLE CONSECUTIVE_FAILURES PENDING_UPLOADS
    PENDING_DELETES LAST_CHECK_EPOCH LAST_SUCCESS_EPOCH LAST_ERROR)
# State is parsed as data, never sourced (code-review session plan 05).
if [[ -r "$KVSTATE" ]]; then
    # shellcheck disable=SC1090
    source "$KVSTATE"
else
    echo "smbproxy-share-worker: state parser $KVSTATE is missing" >&2
    exit 1
fi

MANAGED_MARKER="    # smbproxy-health: backend unavailable"
STATE_MARKER="    # smbproxy-health: share state missing or invalid"
MANAGED_AVAILABLE="    available = no"
# Persistent ownership marker written by smbproxy-sconfig as the first line of
# every frontend section it creates (code-review session plan 07). Sections
# without it are operator-authored and never touched, except pre-marker
# sections that carry the configurator's profile comment or a valid state
# record: those are adopted (the marker is added).
OWNER_MARKER="    # smbproxy-managed: frontend section owned by smbproxy-sconfig"

log() {
    printf '%s\n' "$*"
    command -v logger >/dev/null 2>&1 && logger -t smbproxy-worker -- "$*" || true
}

share_safe_name() {
    printf '%s' "${1//[^A-Za-z0-9_]/_}"
}

hash_text() {
    printf '%s' "$1" | sha256sum | awk '{print $1}'
}

hash_file() {
    sha256sum -- "$1" 2>/dev/null | awk '{print $1}'
}

safe_relative_path() {
    local path="$1"
    [[ -n "$path" && "$path" != /* && "$path" != ".." \
        && "$path" != ../* && "$path" != */../* && "$path" != */.. \
        && "$path" != *$'\n'* ]]
}

data_root_ready() {
    local target
    target=$(findmnt -rn -T "$DATA_ROOT" -o TARGET 2>/dev/null || true)
    [[ "$target" == "$DATA_ROOT" ]]
}

backend_reachable() {
    local ip="$1"
    [[ -n "$ip" ]] || return 1
    timeout "$PROBE_SECONDS" bash -c ">/dev/tcp/${ip}/445" 2>/dev/null
}

backend_mount_active() {
    local mount_path="$1"
    [[ -n "$mount_path" ]] || return 1
    awk -v mp="$mount_path" '$2 == mp && $3 == "cifs" { found=1; exit }
        END { exit !found }' /proc/mounts 2>/dev/null
}

backend_mount_ready() {
    local mount_path="$1"
    [[ -n "$mount_path" ]] || return 1
    timeout "$MOUNT_SECONDS" ls -A -- "$mount_path" >/dev/null 2>&1 \
        || return 1
    backend_mount_active "$mount_path"
}

backend_automount_unit() {
    local mount_path="$1"
    command -v systemd-escape >/dev/null 2>&1 || return 1
    systemd-escape --path --suffix=automount -- "$mount_path" 2>/dev/null
}

backend_mount_unit() {
    local mount_path="$1"
    command -v systemd-escape >/dev/null 2>&1 || return 1
    systemd-escape --path --suffix=mount -- "$mount_path" 2>/dev/null
}

frontend_share_active() {
    local share_name="$1" output
    command -v smbstatus >/dev/null 2>&1 || return 0
    output=$(smbstatus --shares 2>/dev/null) || return 0
    awk -v share="$share_name" '$1 == share { found=1; exit }
        END { exit !found }' <<< "$output"
}

set_direct_automount_availability() {
    local share_name="$1" mount_path="$2" availability="$3"
    local unit mount_unit load_state
    [[ -n "$mount_path" ]] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    unit=$(backend_automount_unit "$mount_path") || return 0
    load_state=$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)
    [[ "$load_state" == "loaded" ]] || return 0

    case "$availability" in
        offline)
            if backend_mount_active "$mount_path"; then
                if frontend_share_active "$share_name"; then
                    log "share=${share_name} backend cleanup deferred: frontend session active"
                    return 0
                fi
                mount_unit=$(backend_mount_unit "$mount_path") || return 0
                if ! systemctl stop "$unit" "$mount_unit"; then
                    log "share=${share_name} mount cleanup failed backend=offline"
                    return 1
                fi
                if backend_mount_active "$mount_path"; then
                    log "share=${share_name} mount remains active after cleanup"
                    return 1
                fi
                systemctl reset-failed "$mount_unit" >/dev/null 2>&1 || true
                log "share=${share_name} mount=${mount_unit} state=stopped backend=offline"
                return 0
            fi
            if systemctl is-active --quiet "$unit" 2>/dev/null; then
                if systemctl stop "$unit"; then
                    log "share=${share_name} automount=${unit} state=stopped backend=offline"
                else
                    log "share=${share_name} automount=${unit} stop failed backend=offline"
                    return 1
                fi
            fi
            ;;
        online)
            if ! systemctl is-active --quiet "$unit" 2>/dev/null; then
                if systemctl start "$unit"; then
                    log "share=${share_name} automount=${unit} state=started backend=online"
                else
                    log "share=${share_name} automount=${unit} start failed backend=online"
                    return 1
                fi
            fi
            ;;
    esac
}

load_health() {
    local safe="$1"
    local file="${HEALTH_DIR}/${safe}.env"
    HEALTH_FAILURES=0
    HEALTH_LAST_SUCCESS=0
    if [[ -r "$file" ]]; then
        local CONSECUTIVE_FAILURES="" LAST_SUCCESS_EPOCH=""
        local MODE BACKEND_REACHABLE PENDING_UPLOADS PENDING_DELETES LAST_CHECK_EPOCH LAST_ERROR
        # An unreadable record restarts the counters; it is rewritten below.
        appcore_kv_load "$file" "${HEALTH_KEYS[@]}" 2>/dev/null || true
        HEALTH_FAILURES="${CONSECUTIVE_FAILURES:-0}"
        HEALTH_LAST_SUCCESS="${LAST_SUCCESS_EPOCH:-0}"
    fi
    [[ "$HEALTH_FAILURES" =~ ^[0-9]+$ ]] || HEALTH_FAILURES=0
    [[ "$HEALTH_LAST_SUCCESS" =~ ^[0-9]+$ ]] || HEALTH_LAST_SUCCESS=0
}

write_health() {
    local safe="$1" mode="$2" reachable="$3" failures="$4"
    local uploads="$5" deletes="$6" last_success="$7" error="${8:-}"
    local file="${HEALTH_DIR}/${safe}.env"
    install -d -m 0755 "$HEALTH_DIR"
    # Error text can quote backend output: keep it printable and inert.
    error=$(printf '%s' "$error" | tr -c '[:print:]' ' ' | tr '"`\\$' "''/S")
    error="${error:0:500}"
    appcore_kv_write "$file" 0644 \
        MODE "$mode" BACKEND_REACHABLE "$reachable" \
        CONSECUTIVE_FAILURES "$failures" PENDING_UPLOADS "$uploads" \
        PENDING_DELETES "$deletes" LAST_CHECK_EPOCH "$(date +%s)" \
        LAST_SUCCESS_EPOCH "$last_success" LAST_ERROR "$error"
}

write_manifest_entry() {
    local manifest="$1" id="$2" rel="$3" checksum="$4"
    local path_tmp="${manifest}/${id}.path.new.$$"
    local sha_tmp="${manifest}/${id}.sha256.new.$$"
    printf '%s\n' "$rel" > "$path_tmp"
    printf '%s\n' "$checksum" > "$sha_tmp"
    mv "$path_tmp" "${manifest}/${id}.path"
    mv "$sha_tmp" "${manifest}/${id}.sha256"
}

deploy_file() {
    local local_root="$1" backend_root="$2" manifest="$3"
    local rel="$4" id="$5" checksum_before="$6"
    local src="${local_root}/${rel}" dst="${backend_root}/${rel}"
    local dst_dir tmp checksum_after

    backend_mount_active "$backend_root" || return 1
    dst_dir=$(dirname "$dst")
    mkdir -p -- "$dst_dir" || return 1
    tmp="${dst}.smbproxy-part-${id:0:12}"
    rm -f -- "$tmp"
    if ! cp -- "$src" "$tmp"; then
        rm -f -- "$tmp"
        return 1
    fi
    touch -r "$src" "$tmp" 2>/dev/null || true

    # Do not publish a mixed/partial version if the office file changed
    # while it was being copied.
    checksum_after=$(hash_file "$src")
    if [[ -z "$checksum_after" || "$checksum_after" != "$checksum_before" ]]; then
        rm -f -- "$tmp"
        return 1
    fi
    if ! mv -f -- "$tmp" "$dst"; then
        rm -f -- "$tmp"
        return 1
    fi
    # If the mount dropped after the rename, leave the manifest pending.
    # Retrying an acknowledged upload is safe; falsely recording a write
    # that landed under an unmounted automount directory is not.
    backend_mount_active "$backend_root" || return 1
    write_manifest_entry "$manifest" "$id" "$rel" "$checksum_after"
}

sync_queued_share() {
    local safe="$1" reachable="$2"
    local local_root="${DATA_ROOT}/shares/${safe}"
    local state_root="${DATA_ROOT}/state/${safe}"
    local manifest="${state_root}/manifest"
    local pending_upload="${state_root}/pending-upload"
    local pending_delete="${state_root}/pending-delete"
    local can_deploy=0 src rel id checksum recorded

    SYNC_PENDING_UPLOADS=0
    SYNC_PENDING_DELETES=0
    SYNC_LAST_ERROR=""

    if ! data_root_ready; then
        SYNC_LAST_ERROR="data filesystem is not mounted at ${DATA_ROOT}"
        return 1
    fi

    install -d -m 0755 "$local_root" "$state_root" "$manifest" \
        "$pending_upload" "$pending_delete"
    if [[ -n "${FRONT_FORCE_USER:-}" ]]; then
        chown "$FRONT_FORCE_USER:$FRONT_FORCE_USER" "$local_root" 2>/dev/null || true
        chmod 0770 "$local_root" 2>/dev/null || true
    fi

    if [[ "$reachable" == "yes" ]] && backend_mount_ready "$BACKEND_MOUNT"; then
        can_deploy=1
    elif [[ "$reachable" == "yes" ]]; then
        SYNC_LAST_ERROR="backend SMB mount did not become ready within ${MOUNT_SECONDS}s"
    else
        SYNC_LAST_ERROR="backend tcp/445 is unreachable"
    fi

    # Uploads and updates happen before deletions. An office-side rename is
    # therefore deployed under the new name before its old managed path is
    # removed from the machine.
    while IFS= read -r -d '' src; do
        rel="${src#"$local_root"/}"
        if ! safe_relative_path "$rel"; then
            log "share=${SHARE_NAME} skipped unsupported path"
            continue
        fi
        id=$(hash_text "$rel")
        checksum=$(hash_file "$src")
        [[ -n "$checksum" ]] || {
            SYNC_PENDING_UPLOADS=$((SYNC_PENDING_UPLOADS + 1))
            continue
        }
        recorded=""
        [[ -r "${manifest}/${id}.sha256" ]] \
            && IFS= read -r recorded < "${manifest}/${id}.sha256"
        if [[ "$recorded" == "$checksum" ]]; then
            rm -f -- "${pending_upload}/${id}.path" \
                "${pending_upload}/${id}.sha256" \
                "${pending_delete}/${id}"
            continue
        fi
        rm -f -- "${pending_delete}/${id}"

        # Require the same checksum on two worker passes before publishing.
        # This keeps a file that is still being copied into the office share
        # from appearing briefly as a partial CNC program on the machine.
        local pending_checksum=""
        [[ -r "${pending_upload}/${id}.sha256" ]] \
            && IFS= read -r pending_checksum < "${pending_upload}/${id}.sha256"
        if [[ "$pending_checksum" != "$checksum" ]]; then
            write_manifest_entry "$pending_upload" "$id" "$rel" "$checksum"
            SYNC_PENDING_UPLOADS=$((SYNC_PENDING_UPLOADS + 1))
            continue
        fi
        if [[ "$can_deploy" -eq 1 ]] \
            && deploy_file "$local_root" "$BACKEND_MOUNT" "$manifest" \
                "$rel" "$id" "$checksum"; then
            rm -f -- "${pending_upload}/${id}.path" \
                "${pending_upload}/${id}.sha256"
            log "share=${SHARE_NAME} uploaded path=${rel}"
        else
            SYNC_PENDING_UPLOADS=$((SYNC_PENDING_UPLOADS + 1))
        fi
    done < <(find "$local_root" -xdev -type f -print0 2>/dev/null)

    # Drop stability candidates for files that disappeared before they
    # became deployable (for example an editor's short-lived temp file).
    local pending_path
    shopt -s nullglob
    for pending_path in "$pending_upload"/*.path; do
        rel=""
        IFS= read -r rel < "$pending_path"
        if ! safe_relative_path "$rel" || [[ ! -e "${local_root}/${rel}" ]]; then
            rm -f -- "$pending_path" "${pending_path%.path}.sha256"
        fi
    done

    local path_file target
    for path_file in "$manifest"/*.path; do
        rel=""
        IFS= read -r rel < "$path_file"
        if ! safe_relative_path "$rel"; then
            log "share=${SHARE_NAME} ignored invalid manifest path"
            continue
        fi
        id=$(basename "${path_file%.path}")
        if [[ -e "${local_root}/${rel}" ]]; then
            rm -f -- "${pending_delete}/${id}"
            continue
        fi

        # Like uploads, require two observations. Also never delete while
        # any upload is pending, preserving upload-new-before-delete-old
        # ordering for office-side renames.
        if [[ ! -e "${pending_delete}/${id}" ]]; then
            : > "${pending_delete}/${id}"
            SYNC_PENDING_DELETES=$((SYNC_PENDING_DELETES + 1))
            continue
        fi
        if [[ "$SYNC_PENDING_UPLOADS" -gt 0 ]]; then
            SYNC_PENDING_DELETES=$((SYNC_PENDING_DELETES + 1))
            continue
        fi

        if [[ "$can_deploy" -eq 1 ]]; then
            target="${BACKEND_MOUNT}/${rel}"
            if rm -f -- "$target" && backend_mount_active "$BACKEND_MOUNT"; then
                rm -f -- "$path_file" "${path_file%.path}.sha256" \
                    "${pending_delete}/${id}"
                log "share=${SHARE_NAME} deleted managed path=${rel}"
            else
                SYNC_PENDING_DELETES=$((SYNC_PENDING_DELETES + 1))
            fi
        else
            SYNC_PENDING_DELETES=$((SYNC_PENDING_DELETES + 1))
        fi
    done
    shopt -u nullglob
    return 0
}

render_direct_availability_unlocked() {
    local direct_file="$1"
    [[ -f "$SMB_CONF" ]] || return 0
    local candidate="${SMB_CONF}.health.$$"

    # Rows: NAME<TAB>PATH<TAB>online|offline|withdrawn, one per managed
    # section. Only listed sections are rewritten; every other section,
    # including one that still carries a withdrawal this worker no longer
    # understands, is copied byte for byte.
    #
    # Replace the configured path in place rather than appending an override.
    # smbd validates a path while loading its line, so merely adding a later
    # path directive still blocks in stat(2) on a disconnected CIFS mount.
    # The per-share state file supplies the original path for recovery.
    awk -F '\t' -v offline_marker="$MANAGED_MARKER" \
        -v state_marker="$STATE_MARKER" -v owner="$OWNER_MARKER" \
        -v setting="$MANAGED_AVAILABLE" -v offline_path="$OFFLINE_PATH" '
        function emit_withdrawal() {
            if (listed && state[current_section] == "offline") {
                print offline_marker
                print setting
            } else if (listed && state[current_section] == "withdrawn") {
                print state_marker
                print setting
            }
            listed = 0
        }
        FILENAME == ARGV[1] {
            section = "[" $1 "]"
            configured_path[section] = $2
            state[section] = $3
            next
        }
        /^\[[^]]+\][[:space:]]*$/ {
            emit_withdrawal()
            current_section = $0
            sub(/[[:space:]]+$/, "", current_section)
            listed = (current_section in state)
            print
            if (listed) print owner
            drop_setting = 0
            next
        }
        listed && $0 == owner { next }
        listed && index($0, "    # smbproxy-health:") == 1 {
            drop_setting = 1
            next
        }
        listed && drop_setting && $0 == setting {
            drop_setting = 0
            next
        }
        listed && /^[[:space:]]*path[[:space:]]*=/ {
            drop_setting = 0
            print "    path = " \
                (state[current_section] == "online" \
                    ? configured_path[current_section] : offline_path)
            next
        }
        { drop_setting = 0; print }
        END { emit_withdrawal() }
    ' "$direct_file" "$SMB_CONF" > "$candidate"

    if cmp -s "$candidate" "$SMB_CONF"; then
        rm -f "$candidate"
        return 0
    fi
    if command -v testparm >/dev/null 2>&1 \
        && ! testparm -s "$candidate" >/dev/null 2>&1; then
        log "availability update rejected by testparm; keeping current smb.conf"
        rm -f "$candidate"
        return 1
    fi
    chmod 0644 "$candidate"
    mv "$candidate" "$SMB_CONF"
    if [[ "$SKIP_RELOAD" != "1" ]] && systemctl is-active --quiet smbd 2>/dev/null; then
        smbcontrol smbd reload-config >/dev/null 2>&1 || {
            log "smbd reload-config failed after availability update"
            return 1
        }
    fi
}

# Print the names of frontend sections in smb.conf, one per line, each
# followed by a tab and "owned" (ownership marker or the configurator's
# profile comment) or "plain".
smb_conf_sections() {
    [[ -f "$SMB_CONF" ]] || return 0
    awk -v owner="$OWNER_MARKER" '
        function flush() { if (name != "") print name "\t" (owned ? "owned" : "plain") }
        /^\[[^]]+\][[:space:]]*$/ {
            flush()
            name = $0
            sub(/[[:space:]]+$/, "", name)
            name = substr(name, 2, length(name) - 2)
            owned = 0
            if (tolower(name) == "global") name = ""
            next
        }
        $0 == owner { owned = 1 }
        /^[[:space:]]*# profile=[a-z]+; locking=/ { owned = 1 }
        END { flush() }
    ' "$SMB_CONF"
}

render_direct_availability() {
    local direct_file="$1"
    if ! command -v flock >/dev/null 2>&1; then
        render_direct_availability_unlocked "$direct_file"
        return
    fi
    local lock_fd rc
    install -d -m 0755 "$(dirname "$SMB_CONF_LOCK")"
    exec {lock_fd}>"$SMB_CONF_LOCK"
    flock -x "$lock_fd"
    render_direct_availability_unlocked "$direct_file"
    rc=$?
    exec {lock_fd}>&-
    return "$rc"
}

# Withdraw a managed section whose state record is missing or invalid, and
# record why. The failure count is held at the threshold so recovery takes
# the full offline-recovery path (valid state, reachable backend, mount
# probe) before the section is published again.
withdraw_section() {
    local name="$1" reason="$2" direct_file="$3" safe failures
    safe=$(share_safe_name "$name")
    load_health "$safe"
    failures="$HEALTH_FAILURES"
    (( failures >= FAIL_THRESHOLD )) || failures="$FAIL_THRESHOLD"
    log "share=${name} withdrawn: ${reason}"
    printf '%s\t%s\t%s\n' "$name" "$OFFLINE_PATH" withdrawn >> "$direct_file"
    write_health "$safe" direct no "$failures" 0 0 "$HEALTH_LAST_SUCCESS" \
        "share withdrawn: ${reason}" || true
}

worker_run() {
    install -d -m 0755 "$HEALTH_DIR" "$OFFLINE_PATH" "$PROBE_HINT_DIR"
    local direct_file="${HEALTH_DIR}/direct-shares.$$"
    : > "$direct_file"

    # Inventory (code-review session plan 07): every frontend section in
    # smb.conf, and whether the configurator owns it.
    local -A section_owned=() handled=() bad_state=()
    local sec_name sec_kind
    while IFS=$'\t' read -r sec_name sec_kind; do
        [[ -n "$sec_name" ]] && section_owned["$sec_name"]="$sec_kind"
    done < <(smb_conf_sections)

    shopt -s nullglob
    local share_file safe mode reachable failures last_success mode_error
    local configured_frontend availability previous_failures was_offline hint
    for share_file in "$SHARES_DIR"/*.env; do
        SHARE_NAME="" PROFILE="" OFFLINE_MODE="" BACKEND_IP=""
        BACKEND_MOUNT="" FRONT_FORCE_USER=""
        if ! appcore_kv_load "$share_file" "${SHARE_STATE_KEYS[@]}" 2>/dev/null; then
            bad_state["$(basename "$share_file" .env)"]="state record is malformed"
            log "malformed share state ${share_file}"
            continue
        fi
        if [[ -z "$SHARE_NAME" \
            || "$(share_safe_name "$SHARE_NAME").env" != "$(basename "$share_file")" ]]; then
            bad_state["$(basename "$share_file" .env)"]="state record names a different share"
            log "share state ${share_file} does not match its file name"
            continue
        fi
        if [[ -z "${section_owned[$SHARE_NAME]+x}" ]]; then
            # Orphan state: never create a frontend implicitly.
            safe=$(share_safe_name "$SHARE_NAME")
            load_health "$safe"
            log "share=${SHARE_NAME} has state but no smb.conf section; not published"
            write_health "$safe" "${OFFLINE_MODE:-direct}" no "$HEALTH_FAILURES" 0 0 \
                "$HEALTH_LAST_SUCCESS" "state has no frontend section; not published" || true
            continue
        fi
        handled["$SHARE_NAME"]=1
        safe=$(share_safe_name "$SHARE_NAME")
        mode="${OFFLINE_MODE:-direct}"
        mode_error=""
        if [[ "$mode" == "queued" && "${PROFILE:-legacy}" != "modern" ]]; then
            mode_error="queued mode refused for non-modern profile"
            log "share=${SHARE_NAME} ${mode_error}"
            mode="direct"
        elif [[ "$mode" != "queued" && "$mode" != "direct" ]]; then
            mode_error="unknown offline mode '${mode}'; using direct"
            log "share=${SHARE_NAME} ${mode_error}"
            mode="direct"
        fi
        load_health "$safe"
        previous_failures="$HEALTH_FAILURES"
        hint="${PROBE_HINT_DIR}/${safe}"
        if [[ -e "$hint" ]]; then
            if (( previous_failures < FAIL_THRESHOLD - 1 )); then
                previous_failures=$((FAIL_THRESHOLD - 1))
            fi
            rm -f -- "$hint"
        fi
        failures="$previous_failures"
        last_success="$HEALTH_LAST_SUCCESS"
        was_offline="no"
        (( previous_failures >= FAIL_THRESHOLD )) && was_offline="yes"

        if backend_reachable "${BACKEND_IP:-}"; then
            reachable="yes"
            failures=0
        else
            reachable="no"
            failures=$((failures + 1))
        fi

        case "$mode" in
            queued)
                sync_queued_share "$safe" "$reachable" || true
                if [[ "$reachable" == "yes" && "$SYNC_PENDING_UPLOADS" -eq 0 \
                    && "$SYNC_PENDING_DELETES" -eq 0 && -z "$SYNC_LAST_ERROR" ]]; then
                    last_success=$(date +%s)
                fi
                # The office copy is always served; listing it lifts any
                # earlier state withdrawal now that the record is valid.
                printf '%s\t%s\t%s\n' "$SHARE_NAME" \
                    "${DATA_ROOT}/shares/${safe}" online >> "$direct_file"
                write_health "$safe" "$mode" "$reachable" "$failures" \
                    "$SYNC_PENDING_UPLOADS" "$SYNC_PENDING_DELETES" \
                    "$last_success" "$SYNC_LAST_ERROR"
                ;;
            *)
                if (( failures >= FAIL_THRESHOLD )); then
                    availability="offline"
                else
                    availability="online"
                fi
                if [[ "${PROFILE:-legacy}" == "legacy" ]]; then
                    configured_frontend="$SESSION_ROOT"
                else
                    configured_frontend="$BACKEND_MOUNT"
                    if [[ "$availability" == "online" ]]; then
                        set_direct_automount_availability "$SHARE_NAME" \
                            "$BACKEND_MOUNT" online || true
                        if [[ "$was_offline" == "yes" ]] \
                            && ! backend_mount_ready "$BACKEND_MOUNT"; then
                            reachable="no"
                            failures=$((previous_failures + 1))
                            availability="offline"
                            mode_error="backend SMB mount failed recovery probe"
                            set_direct_automount_availability "$SHARE_NAME" \
                                "$BACKEND_MOUNT" offline || true
                        fi
                    elif [[ "$was_offline" == "yes" ]]; then
                        # The prior worker pass already withdrew and reloaded
                        # this share. Cleanup is deferred until now so an
                        # in-progress tree connect cannot race the unmount.
                        set_direct_automount_availability "$SHARE_NAME" \
                            "$BACKEND_MOUNT" offline || true
                    fi
                fi
                printf '%s\t%s\t%s\n' "$SHARE_NAME" \
                    "$configured_frontend" "$availability" >> "$direct_file"
                [[ "$reachable" == "yes" ]] && last_success=$(date +%s)
                write_health "$safe" "direct" "$reachable" "$failures" \
                    0 0 "$last_success" "$mode_error"
                ;;
        esac
    done
    shopt -u nullglob

    # Every owned section without a valid record is withdrawn. A missing
    # record never re-enables a section.
    local reason
    for sec_name in "${!section_owned[@]}"; do
        [[ "${section_owned[$sec_name]}" == owned && -z "${handled[$sec_name]+x}" ]] || continue
        safe=$(share_safe_name "$sec_name")
        if [[ -n "${bad_state[$safe]+x}" ]]; then
            reason="${bad_state[$safe]}"
        elif [[ -e "${SHARES_DIR}/${safe}.env" ]]; then
            reason="state record is unreadable"
        else
            reason="state record is missing"
        fi
        withdraw_section "$sec_name" "$reason" "$direct_file"
    done

    render_direct_availability "$direct_file"
    rm -f "$direct_file"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    install -d -m 0755 "$(dirname "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    flock -n 9 || exit 0
    worker_run
fi
